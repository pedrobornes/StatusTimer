BACKEND_BASE_URL=http://localhost:8080
BACKEND_API_KEY=your-local-secret-key
REQUEST_TIMEOUT_SECONDS=15
REQUEST_RETRY_MAX_ATTEMPTS=3
REQUEST_RETRY_DELAY_SECONDS=5
HARVEST_INTERVAL_SECONDS=300

# Optional external sources (Task 1 harvesters)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Steam Web API (required for live player/server telemetry on Steam titles)
# Get your key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Optional LLM hook (Task 2 patch-note summarizer)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder-v2:16b
