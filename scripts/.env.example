BACKEND_BASE_URL=http://localhost:8080
BACKEND_API_KEY=your-local-secret-key

# Docker MySQL (see /docker-compose.yml)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=statustimer
MYSQL_USER=root
MYSQL_PASSWORD=root
# Optional full SQLAlchemy override:
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/statustimer?charset=utf8mb4

REQUEST_TIMEOUT_SECONDS=15
REQUEST_RETRY_MAX_ATTEMPTS=3
REQUEST_RETRY_DELAY_SECONDS=5
HARVEST_INTERVAL_SECONDS=300
DEDUP_STATE_FILE=.harvest_state/processed_hashes.json
FEED_LOOKBACK_DAYS=7
NEWS_MAX_INGEST_AGE_DAYS=30
STEAM_NEWS_MAX_ITEMS=10
STEAM_NEWS_TOP_N=15
ENABLE_REDDIT_NEWS=false
CONTEXT_STORE_DIR=.harvest_state/context
CONTEXT_CHUNK_MAX_CHARS=480
CONTEXT_CHUNK_OVERLAP_CHARS=80
CONTEXT_MAX_CHUNKS_PER_GAME=200
CONTEXT_SEARCH_LIMIT=8

# Optional external sources (Task 1 harvesters)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
IGDB_RELEASES_LIMIT=25
IGDB_MIN_HYPE=10
IGDB_CATALOG_ENRICH_LIMIT=25
IGDB_SEARCH_LIMIT=8
# Steam Web API (required for live player/server telemetry on Steam titles)
# Get your key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Steam Charts catalog harvest (top played titles)
STEAM_CHARTS_TOP_N=50

# Twitch Helix catalog harvest (top watched games)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_TOP_N=100

# Riot developer status endpoints (required for Riot incident scraping)
# Get your key at: https://developer.riotgames.com/
RIOT_API_KEY=

# Optional LLM hook (Task 2 patch-note summarizer + telemetry ambiguity resolver)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder-v2:16b
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT_SECONDS=120
INCIDENT_FALLBACK_MESSAGE=NO_ACTIONABLE_STATUS_INFO

# Internal telemetry ingestion (Phase 18)
# Primary: POST /api/v1/internal/telemetry/update
# Legacy fallback: POST /api/v1/internal/status/sync
