# Local development (default profile: local, H2 in-memory)
SPRING_PROFILES_ACTIVE=local
APP_API_KEY=your-local-secret-key

# Production / Railway (profile: prod)
# Option A: discrete variables
# SPRING_PROFILES_ACTIVE=prod
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=statustimer
# DB_USER=statustimer
# DB_PASSWORD=change-me

# Option B: full JDBC URL override (takes precedence over DB_*)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/statustimer?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Option C: Railway-style DATABASE_URL (mysql://user:pass@host:port/db)
# DATABASE_URL=mysql://statustimer:change-me@containers-us-west-1.railway.app:3306/railway

# Railway MySQL plugin fallbacks (used when DB_* are not set)
# MYSQLHOST=localhost
# MYSQLPORT=3306
# MYSQLDATABASE=statustimer
# MYSQLUSER=statustimer
# MYSQLPASSWORD=change-me
