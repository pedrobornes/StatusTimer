# Local development (profile: local, Docker MySQL on localhost:3306)
SPRING_PROFILES_ACTIVE=local
APP_API_KEY=your-local-secret-key
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Docker Compose MySQL (see /docker-compose.yml)
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3307/statustimer?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Production / Railway (profile: prod)
# SPRING_PROFILES_ACTIVE=prod
# APP_API_KEY=<random-secret-at-least-32-chars>
# APP_CORS_ORIGINS=https://status-timer.com,https://www.status-timer.com
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=statustimer
# DB_USER=statustimer
# DB_PASSWORD=change-me

# IGDB — game search and metadata (same Twitch Developer credentials)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
IGDB_SEARCH_LIMIT=8

# Railway — limit JVM heap to reduce memory billing (adjust if OOM on startup)
# JAVA_TOOL_OPTIONS=-Xmx512m

# Railway-style DATABASE_URL (prod profile only)
# DATABASE_URL=mysql://statustimer:change-me@containers-us-west-1.railway.app:3306/railway
